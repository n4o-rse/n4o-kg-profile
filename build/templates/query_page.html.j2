<!DOCTYPE html>
<html lang="en-GB">
<head>
{% include "_head.html.j2" %}
<title>{{ query.title }} &mdash; {{ page.title|default('queries') }}</title>
</head>
<body>
<div class="container">
  <nav class="nav">
    <a href="../index.html">Collection</a>
    <a href="index.html">Queries</a>
    <a href="../map.html">Map</a>
  </nav>

  <p class="meta"><a href="index.html">&larr; All queries</a></p>

  <header class="page-head">
    <h1>{{ query.title }}</h1>
    {% if query.intro %}<p class="intro">{{ query.intro }}</p>{% endif %}
  </header>

{% include "_status.html.j2" %}

  <section class="query">
    <textarea class="sparql" id="src" spellcheck="false" rows="{{ query.rows }}">{{ query.sparql }}</textarea>
    <div class="query-bar">
      <button class="run" id="run"{% if engine == 'pyodide' %} disabled{% endif %}>Run</button>
      <button class="reset" id="reset">Reset</button>
      <a class="rq" href="rq/{{ query.id }}.rq" download>{{ query.id }}.rq</a>
      <span class="timing" id="timing"></span>
    </div>
{% if query.controls %}
    <div class="controls" id="controls"></div>
{% endif %}
    <div class="view" id="view"></div>
    <div class="downloads" id="downloads"></div>
    <div class="result" id="out"></div>
  </section>

  <footer class="page-foot">
    <p>
      Also available as a plain file: <a href="rq/{{ query.id }}.rq"><code>{{ query.id }}.rq</code></a>.
      The graph is <a href="{{ graph.page_url }}">{{ graph.url }}</a>{% if graph.megabytes %}
      ({{ graph.megabytes }}&nbsp;MB){% endif %}.
    </p>
  </footer>
</div>

<script type="module">
import { boot, ask, renderTable, hasGeometry, renderMap, VIEWS,
         readControl, applyControls, offerDownloads } from './runner.js';

const VIEW = {{ view|tojson }};
const COLS = {{ view_cols_json }};
const CONTROLS = {{ controls_json }};
const ORIGINAL = {{ query_json }};
const ID = {{ query.id|tojson }};
const src = document.getElementById('src');
const out = document.getElementById('out');
const viewEl = document.getElementById('view');
const timing = document.getElementById('timing');
const btn = document.getElementById('run');
const dl = document.getElementById('downloads');

/* Sliders are built from the query, not from the config alone: the starting
   value is whatever the VALUES clause says, so editing the query and pressing
   Reset keeps the two in step. */
function buildControls() {
  const host = document.getElementById('controls');
  if (!host || !CONTROLS.length) return;
  host.innerHTML = CONTROLS.map(c => {
    const v = readControl(src.value, c.var);
    return `<label class="ctl"><span>${c.label}</span>` +
      `<input type="range" data-var="${c.var}" min="${c.min}" max="${c.max}" ` +
      `step="${c.step}" value="${v}"><output data-out="${c.var}">${v}</output></label>`;
  }).join('');
  host.querySelectorAll('input[type=range]').forEach(i => {
    i.addEventListener('input', () => {
      host.querySelector(`[data-out="${i.dataset.var}"]`).textContent = i.value;
    });
    i.addEventListener('change', () => { writeBack(); run(); });
  });
}

/* Write the slider values back into the query itself, so that what runs is
   what the reader can see and copy. A hidden second version of the query would
   make the .rq link and the textarea disagree the moment a slider moved. */
function writeBack() {
  src.value = applyControls(src.value, controlValues());
}

function controlValues() {
  const host = document.getElementById('controls');
  if (!host) return [];
  return [...host.querySelectorAll('input[type=range]')]
    .map(i => ({ var: i.dataset.var, value: i.value }));
}

async function run() {
  btn.disabled = true;
  timing.textContent = 'running\u2026';
  out.innerHTML = ''; viewEl.innerHTML = '';
  const t0 = performance.now();
  try {
    const data = await ask(src.value);
    /* The map is drawn whenever the result carries coordinates, whatever the
       query declared: a result with points is a result worth seeing on a map,
       and the reader should not have to know about a config key to get one. */
    if (VIEW !== 'table' && VIEWS[VIEW]) VIEWS[VIEW](viewEl, data, COLS);
    else if (hasGeometry(data)) renderMap(viewEl, data, COLS);
    renderTable(out, data);
    offerDownloads(dl, data, ID);
    const dt = ((performance.now() - t0) / 1000).toFixed(1);
    timing.textContent = data.n ? `${dt}s over ${data.n} triples` : `${dt}s`;
  } catch (err) {
    dl.innerHTML = '';
    /* Show the real error. A malformed query is the normal case here — people
       are meant to edit these — so the message has to be the actual error. */
    out.innerHTML = `<pre class="error">${err.message}</pre>`;
    timing.textContent = '';
  }
  btn.disabled = false;
}

btn.addEventListener('click', run);
document.getElementById('reset').addEventListener('click', () => {
  src.value = ORIGINAL; out.innerHTML = ''; viewEl.innerHTML = '';
  dl.innerHTML = ''; timing.textContent = '';
  buildControls();
});
buildControls();
boot();
</script>
</body>
</html>
