  "notation": "9",
  "isPartOf": "https://graph.nfdi4objects.net/collection/",
  "description": {
    "en": "Linked Open Data representation of Irish Ogham stones, their inscriptions, readings and find spots, linked to Wikidata, OpenStreetMap and Pleiades.",
    "de": "Linked-Open-Data-Repraesentation irischer Ogham-Steine, ihrer Inschriften, Lesungen und Fundorte, verknuepft mit Wikidata, OpenStreetMap und Pleiades."
  },
  "creators": [
    {
      "type": [
        "Person"
      ],
      "name": "Thiery, Florian",
