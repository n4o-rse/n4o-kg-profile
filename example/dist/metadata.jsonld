  },
  "issued": "2021-05-19",
  "modified": "2026-08-19",
  "version": "1.0.0",
  "resourceType": "http://purl.org/dc/dcmitype/Dataset",
  "accessRights": "http://publications.europa.eu/resource/authority/access-right/PUBLIC",
  "landingPage": "https://ogham.link/",
  "keywords": [
    "Ogham",
    "Ireland",
    "Epigraphy",
    "Linked Open Data",
    "CIDOC CRM"
  ],
  "language": [
    "http://id.loc.gov/vocabulary/iso639-1/en"
  ],
  "conformsTo": [
    "https://w3id.org/nfdi4objects/profile/v0.1"
  ],
  "distributions": [
    {
      "role": "bundle",
      "title": {
        "en": "RDF bundle (data and ontology)",
        "de": "RDF-Bundle (Daten und Ontologie)"
      },
      "file": "rdf/example-bundle.ttl",
      "accessURL": "https://github.com/n4o-rse/n4o-kg-profile/",
      "downloadURL": "https://raw.githubusercontent.com/n4o-rse/n4o-kg-profile/main/example/rdf/example-bundle.ttl",
      "mediaType": "https://www.iana.org/assignments/media-types/text/turtle"
    }
  ],
  "model": {
    "bundle": "rdf/example-bundle.ttl",
    "classes": [
      {
        "class": "http://ontology.ogham.link/OghamStone",
        "crm": "http://www.cidoc-crm.org/cidoc-crm/E22_Human-Made_Object"
      },
      {
        "class": "http://ontology.ogham.link/Inscription",
        "crm": "http://www.cidoc-crm.org/cidoc-crm/E34_Inscription"
      },
      {
        "class": "http://ontology.ogham.link/Reading",
        "crm": "http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"
      },
      {
        "class": "http://ontology.ogham.link/Townland",
        "crm": "http://www.cidoc-crm.org/cidoc-crm/E53_Place"
      }
    ],
    "properties": [
      {
        "property": "http://ontology.ogham.link/within",
        "crm": "http://www.cidoc-crm.org/cidoc-crm/P89_falls_within"
      }
    ]
  },
  "prefixes": "PREFIX ogham: <http://ontology.ogham.link/>\nPREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n",
  "queries": [
    {
      "id": "classes-with-counts",
      "title": {
        "en": "Classes used, with counts",
        "de": "Verwendete Klassen mit Anzahl"
      },
      "intro": {
        "en": "What occurs in this collection — the counterpart to the VoID statistics.",
        "de": "Was in dieser Sammlung vorkommt — die Gegenprobe zur VoID-Statistik."
      },
      "sparql": "SELECT ?class (COUNT(?s) AS ?count) WHERE {\n  ?s a ?class\n} GROUP BY ?class ORDER BY DESC(?count)\n"
    },
    {
      "id": "stones-via-crm",
      "title": {
        "en": "Ogham stones via their CRM superclass",
        "de": "Ogham-Steine ueber die CRM-Oberklasse"
      },
      "intro": {
        "en": "Checks that the CIDOC CRM alignment works: the query asks for E22 and is answered from ogham:OghamStone.",
        "de": "Prueft, ob die Ausrichtung auf CIDOC CRM greift: gefragt wird nach E22, geantwortet wird aus ogham:OghamStone."
      },
      "sparql": "SELECT ?stone ?label WHERE {\n  ?stone a/rdfs:subClassOf* crm:E22_Human-Made_Object ;\n         rdfs:label ?label\n} ORDER BY ?label"
    }
  ]
}
