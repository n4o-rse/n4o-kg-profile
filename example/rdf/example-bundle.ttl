# Beispiel-Bundle: Daten + Ontologie in einer Datei, so wie es in den
# N4O KG eingespielt wird. Instanzen sind synthetisch und dienen nur dazu,
# den Build und die Beispielabfragen lauffaehig zu halten.

@prefix ogham: <http://ontology.ogham.link/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix ex:    <https://ogham.link/id/> .
@prefix geo:   <http://www.opengis.net/ont/geosparql#> .

### Ontologie ################################################################

ogham:OghamStone  a owl:Class ; rdfs:label "Ogham Stone"@en .
ogham:Inscription a owl:Class ; rdfs:label "Inscription"@en .
ogham:Reading     a owl:Class ; rdfs:label "Reading"@en .
ogham:Townland    a owl:Class ; rdfs:label "Townland"@en .

ogham:within     a owl:ObjectProperty ; rdfs:label "within"@en .
ogham:hasReading a owl:ObjectProperty ; rdfs:label "has reading"@en .

### Daten ####################################################################

ex:stone1 a ogham:OghamStone ;
    rdfs:label "CIIC 1 Ballinrannig"@en ;
    ogham:within ex:townland1 ;
    ogham:hasReading ex:reading1 ;
    geo:hasGeometry [ geo:asWKT "POINT(-10.35 52.16)"^^geo:wktLiteral ] .

ex:stone2 a ogham:OghamStone ;
    rdfs:label "CIIC 2 Ballinrannig"@en ;
    ogham:within ex:townland1 ;
    geo:hasGeometry [ geo:asWKT "POINT(-10.34 52.17)"^^geo:wktLiteral ] .

ex:inscription1 a ogham:Inscription ;
    rdfs:label "Inscription on CIIC 1"@en .

ex:reading1 a ogham:Reading ;
    rdfs:label "Reading by Macalister 1945"@en .

ex:townland1 a ogham:Townland ;
    rdfs:label "Ballinrannig"@en ;
    geo:hasGeometry [ geo:asWKT "POINT(-10.35 52.16)"^^geo:wktLiteral ] .
